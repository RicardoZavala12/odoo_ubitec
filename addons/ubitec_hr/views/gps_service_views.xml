<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gps_service_list_leave_inherit" model="ir.ui.view">
        <field name="name">gps.service.list.leave.inherit</field>
        <field name="model">gps.service</field>
        <field name="inherit_id" ref="gps_service.view_gps_service_list"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-danger">technician_on_leave</attribute>
            </list>
            <field name="technician_id" position="after">
                <field name="technician_on_leave" string="¿De vacaciones?"/>
            </field>
        </field>
    </record>
    <record id="view_gps_service_calendar_leave_inherit" model="ir.ui.view">
        <field name="name">gps.service.calendar.leave.inherit</field>
        <field name="model">gps.service</field>
        <field name="inherit_id" ref="gps_service.view_gps_service_calendar"/>
        <field name="arch" type="xml">
            <field name="technician_id" position="after">
                <field name="technician_on_leave" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
