<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_ubitec" model="ir.module.category">
        <field name="name">Ubitec</field>
        <field name="sequence">21</field>
    </record>

    <!-- Personal comercial: ventas y soporte. Da acceso a Equipos GPS y
         Contactos sin necesidad de abrirlos a cualquier usuario interno. -->
    <record id="group_ubitec_comercial" model="res.groups">
        <field name="name">Personal comercial</field>
        <field name="category_id" ref="module_category_ubitec"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
