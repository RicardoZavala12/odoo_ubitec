<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tarea diaria: pasa de 'Nuevo' a 'Activo' tras 30 días del alta -->
        <record id="cron_ubitec_estado_nuevo" model="ir.cron">
            <field name="name">Ubitec: actualizar estado Nuevo -> Activo</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_actualizar_estado_nuevo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Diario 8am (hora CDMX): avisa que clientes/equipos pagan HOY -->
        <record id="cron_ubitec_alerta_cobros_hoy" model="ir.cron">
            <field name="name">Ubitec: alerta cobros de hoy</field>
            <field name="model_id" ref="model_contract_line"/>
            <field name="state">code</field>
            <field name="code">model.cron_alerta_cobros_hoy()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-10-05 14:00:00</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Domingos 8am (hora CDMX): avisa que clientes/equipos pagan esta semana -->
        <record id="cron_ubitec_alerta_cobros_semana" model="ir.cron">
            <field name="name">Ubitec: alerta cobros de la semana</field>
            <field name="model_id" ref="model_contract_line"/>
            <field name="state">code</field>
            <field name="code">model.cron_alerta_cobros_semana()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall">2026-10-11 14:00:00</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
