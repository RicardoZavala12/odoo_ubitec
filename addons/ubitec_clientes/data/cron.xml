<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tarea diaria: pasa de 'Nuevo' a 'Activo' tras 30 días del alta -->
        <record id="cron_ubitec_estado_nuevo" model="ir.cron">
            <field name="name">Ubitec: actualizar estado Nuevo -> Activo</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_actualizar_estado_nuevo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
