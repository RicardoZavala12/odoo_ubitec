<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acorta el popup de "actividad asignada" cuando es sobre un cliente
         (res.partner): en vez de "Documento: X (Contacto)" + Resumen + Fecha
         en 3 lineas, deja "Cliente: X — resumen" + "Vence: fecha" en 2.
         Para cualquier otro modelo (CRM, Helpdesk, etc.) se deja igual. -->
    <template id="message_activity_assigned_ubitec" inherit_id="mail.message_activity_assigned">
        <xpath expr="//ul" position="replace">
            <ul t-if="activity.res_model == 'res.partner'">
                <li>Cliente: <t t-esc="activity.res_name"/><t t-if="activity.summary"> — <span t-field="activity.summary"/></t></li>
                <li>Vence: <span t-field="activity.date_deadline"/></li>
            </ul>
            <ul t-else="">
                <li>Document: "<t t-esc="activity.res_name"/>"
                    <t t-if="model_description"> (<t t-esc="model_description"/>)</t>
                </li>
                <li t-if="activity.summary">Summary: <span t-field="activity.summary"/></li>
                <li>Deadline: <span t-field="activity.date_deadline"/></li>
            </ul>
        </xpath>
    </template>
</odoo>
