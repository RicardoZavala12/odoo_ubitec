<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ubitec_clientes.PasswordToggleField">
        <div class="o_field_password d-inline-flex align-items-center">
            <input
                t-att-type="inputType"
                class="o_input"
                t-att-id="props.id"
                t-att-value="props.record.data[props.name] || ''"
                t-att-readonly="props.readonly"
                t-on-change="(ev) => this.props.record.update({ [this.props.name]: ev.target.value })"
            />
            <button
                type="button"
                class="btn btn-link p-1 ms-1"
                t-on-click="toggleVisibility"
                title="Mostrar / ocultar">
                <i t-att-class="state.visible ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
            </button>
        </div>
    </t>

</templates>
